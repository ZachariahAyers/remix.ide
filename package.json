{
  "name": "remix-ide-desktop",
  "productName": "Remix IDE Desktop",
  "version": "2.0.0",
  "description": "Remix IDE, the Ethereum smart-contract IDE, in its own locked-down desktop window.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "author": {
    "name": "Zachariah Ayers",
    "url": "https://ayers.repair"
  },
  "homepage": "https://github.com/ZachariahAyers/remix.ide",
  "repository": "github:ZachariahAyers/remix.ide",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "electron-winstaller": true
  }
}
